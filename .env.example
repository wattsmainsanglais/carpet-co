# Gmail SMTP Configuration for Contact Form
# See README.md for detailed setup instructions

# Gmail SMTP host (don't change this)
HOST=smtp.gmail.com

# Your Gmail address
USER=your-email@gmail.com

# Google App Password (16 characters, no spaces)
# Get it from: https://myaccount.google.com/apppasswords
# Note: Requires 2-Step Verification enabled
USERPASS=abcdefghijklmnop
